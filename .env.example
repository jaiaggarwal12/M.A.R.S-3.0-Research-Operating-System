# ═══════════════════════════════════════════════════
#  M.A.R.S 3.0 — Research Operating System
#  Environment Configuration
# ═══════════════════════════════════════════════════

# ── LLM ──────────────────────────────────────────
LLM_PROVIDER=openai               # openai | anthropic | ollama
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
TEMPERATURE=0.1

# ── Neo4j ─────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mars_password_2024

# ── Vector store ──────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Semantic Scholar ──────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=        # Optional — free tier works

# ── Research Memory DB ────────────────────────────
MEMORY_DB_PATH=./data/memory/research_memory.json
EXPERIMENT_HISTORY_DB=./data/memory/experiments.db

# ── Ingestion ─────────────────────────────────────
MAX_PAPERS_PER_QUERY=100
MAX_PAPER_AGE_DAYS=730
FETCH_CITATIONS=true

# ── Autonomous Loop ───────────────────────────────
MAX_LOOP_ITERATIONS=5            # Max self-play research iterations
AUTO_LOOP_ENABLED=false          # Set true to enable autonomous loop

# ── Experiment Runner ─────────────────────────────
EXPERIMENT_RUNNER=local          # local | docker
EXPERIMENT_TIMEOUT_SECONDS=300
EXPERIMENTS_DIR=./data/experiments

# ── Research Twin ─────────────────────────────────
TWIN_PAPERS_DIR=./data/twin_papers

# ── API ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
METRICS_PORT=9090
ENABLE_PROMETHEUS=false

# ── Logging ───────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./data/logs/mars.log
